{
	"name": "obsidian-dragon-glass",
	"version": "0.1.0",
	"description": "Campaign management for TTRPG vaults in Obsidian",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
